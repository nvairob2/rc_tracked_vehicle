#VRML_SIM R2025a utf8
# Комната для Nav2. ENU: Z вверх. File → Open в Webots.

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/81b36aeabdb5c16306e4b7c4cede416158c41d4d/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/81b36aeabdb5c16306e4b7c4cede416158c41d4d/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/81b36aeabdb5c16306e4b7c4cede416158c41d4d/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "../protos/TrackedTank.proto"

WorldInfo {
  title "Tank room — stage 2 Nav2"
  basicTimeStep 16
  coordinateSystem "ENU"
}
Viewpoint {
  orientation 0 0.1 0 0.5
  position -12.3 0 7
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 8 8
  floorTileSize 0.5 0.5
  wallHeight 0.4
}
# Препятствия: translation.z = половина высоты (стоят на полу z=0)
Solid {
  translation 1.5 0.5 0.2
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.7 0.4 0.2 roughness 0.8 }
      geometry Box { size 0.4 0.8 0.4 }
    }
  ]
  name "box1"
  boundingObject Box { size 0.4 0.8 0.4 }
}
Solid {
  translation -1.2 -1.0 0.2
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.2 0.5 0.7 roughness 0.8 }
      geometry Box { size 0.5 1.0 0.4 }
    }
  ]
  name "box2"
  boundingObject Box { size 0.5 1.0 0.4 }
}
Solid {
  translation 0.5 -2.0 0.25
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.5 0.5 0.5 roughness 0.9 }
      geometry Cylinder { height 0.5 radius 0.25 }
    }
  ]
  name "pillar"
  boundingObject Cylinder { height 0.5 radius 0.25 }
}
TrackedTank {
  translation 0 0 0.05
}
