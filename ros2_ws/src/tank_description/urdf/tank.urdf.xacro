<?xml version="1.0"?>
<!-- Гусеничная база + D500 на крыше. Размеры ориентировочные — уточнить обмером. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tracked_tank">

  <xacro:property name="body_length" value="0.40"/>
  <xacro:property name="body_width" value="0.28"/>
  <xacro:property name="body_height" value="0.12"/>
  <xacro:property name="track_width" value="0.05"/>
  <xacro:property name="lidar_z" value="0.18"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${body_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="body_grey">
        <color rgba="0.3 0.3 0.35 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${body_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <origin xyz="0 0 ${body_height/2}" rpy="0 0 0"/>
      <inertia ixx="0.15" ixy="0" ixz="0" iyy="0.20" iyz="0" izz="0.25"/>
    </inertial>
  </link>

  <!-- Левая гусеница (только визуал / collision) -->
  <link name="left_track">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${track_width} 0.06"/>
      </geometry>
      <material name="track_black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${body_length} ${track_width} 0.06"/>
      </geometry>
    </collision>
  </link>
  <joint name="left_track_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_track"/>
    <origin xyz="0 ${body_width/2 + track_width/2} 0.03" rpy="0 0 0"/>
  </joint>

  <link name="right_track">
    <visual>
      <geometry>
        <box size="${body_length} ${track_width} 0.06"/>
      </geometry>
      <material name="track_black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${body_length} ${track_width} 0.06"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_track_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_track"/>
    <origin xyz="0 ${-(body_width/2 + track_width/2)} 0.03" rpy="0 0 0"/>
  </joint>

  <!-- Основание лидара на крыше; zero-угол датчика = +X робота -->
  <link name="ldlidar_base"/>
  <joint name="ldlidar_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ldlidar_base"/>
    <origin xyz="0.05 0 ${lidar_z}" rpy="0 0 0"/>
  </joint>

  <link name="ldlidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.025" length="0.04"/>
      </geometry>
      <material name="lidar_orange">
        <color rgba="1.0 0.5 0.0 1"/>
      </material>
    </visual>
  </link>
  <joint name="ldlidar_joint" type="fixed">
    <parent link="ldlidar_base"/>
    <child link="ldlidar_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>

</robot>
